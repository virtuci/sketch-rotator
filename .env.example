# Hostname artists open in the browser. Caddy issues a certificate from its
# internal CA for it; clipboard write needs HTTPS, so trust that CA on the
# artists' machines (or put a certificate from your own CA in deploy/Caddyfile).
STUDIO_DOMAIN=turnsketch.studio.lan

# Model switches for the GPU workers. The defaults run without any weights.
TS_REFINER=classical            # classical | diffusion
TS_RECONSTRUCTOR=inflate        # inflate | hunyuan3d
TS_DEPTH_ESTIMATOR=none         # none | depth_anything
TS_SEGMENTER=none               # none | sam2

# Checkpoints used when the switches above are on.
TS_SDXL_MODEL=cagliostrolab/animagine-xl-3.1
TS_CONTROLNET_DEPTH=diffusers/controlnet-depth-sdxl-1.0
TS_CONTROLNET_NORMAL=
TS_IP_ADAPTER_REPO=h94/IP-Adapter
TS_DEPTH_MODEL=depth-anything/Depth-Anything-V2-Large-hf
TS_HUNYUAN_MODEL=tencent/Hunyuan3D-2
TS_SAM2_MODEL=facebook/sam2.1-hiera-large
